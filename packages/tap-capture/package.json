{
  "name": "@chargeguard/tap-capture",
  "version": "0.1.0",
  "description": "Capture Visa TAP / AI-agent evidence on your stack and forward it to ChargeGuard. Fire-and-forget, zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.38",
    "fastify": "^5.2.1",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
